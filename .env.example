# Copy to .env and fill in. .env is gitignored - never commit real credentials.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=hr_demo
MYSQL_TABLE=employees

# Fixed chatbot source; no database/table/scope selectors in the client.
# CHATBOT_DATABASE overrides MYSQL_DATABASE for the chatbot only.
# MYSQL_TABLE above remains the dataset loader's table; it does not set chatbot scope.
CHATBOT_DATABASE=employees
# Table scope restricts metadata and SQL to this table; missing tables fail closed.
CHATBOT_TABLE=employees_messy
# Exactly table or schema; table is the default when omitted.
# Set schema explicitly to allow backend joins across discovered base tables
# in CHATBOT_DATABASE. This never grants additional MySQL privileges.
CHATBOT_SCOPE=table
OPENAI_API_KEY=
# Choose a model available to your OpenAI account supporting JSON output.
OPENAI_MODEL=
# Explicit opt-in; all mutations still need confirmation in the UI.
CHATBOT_ALLOW_MUTATIONS=false
CHATBOT_MAX_ROWS=500
CHATBOT_SAMPLE_ROWS=20
CHATBOT_TIMEOUT_SECONDS=15
CHATBOT_SELECT_TIMEOUT_MS=10000

# Optional Azure OpenAI instead of OpenAI; never commit real keys.
# CHATBOT_AI_PROVIDER=azure
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_API_VERSION=2024-10-21
# AZURE_OPENAI_DEPLOYMENT_MINI=your-deployment-name
# AZURE_OPENAI_DEPLOYMENT overrides AZURE_OPENAI_DEPLOYMENT_MINI when supplied.
# Natural-language chat requires explicit question/schema consent AND a configured
# provider key/model (or Azure deployment). No silent opt-in or direct-SQL fallback.
CHATBOT_OPENAI_CONSENT=false
# Separate opt-in to send bounded, best-effort identifier-redacted result samples.
# No consent or model controls are exposed in the client sidebar.
CHATBOT_AI_SUMMARIES=false

# Optional PDF email delivery. Configure privately in .env, never in chat.
CHATBOT_SMTP_HOST=
CHATBOT_SMTP_PORT=587
CHATBOT_SMTP_TLS_MODE=starttls
CHATBOT_SMTP_USER=
CHATBOT_SMTP_PASSWORD=
CHATBOT_SMTP_FROM=
