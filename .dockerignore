# Default deny: only the explicit runtime COPY inputs enter the build context.
**
!Dockerfile
!.dockerignore
!requirements-cloud.txt
!chat_app.py
!chatbot/
!chatbot/**
!assets/
!assets/**
!.streamlit/
!.streamlit/config.toml

# Defense in depth even inside an allowed directory. Last matching rule wins.
**/.env*
**/secrets.toml
**/secrets.*.toml
**/.local
**/.local/**
**/.venv
**/.venv/**
**/.git
**/.git/**
**/__pycache__
**/__pycache__/**
**/*.py[cod]
**/.DS_Store
**/data
**/data/**
**/datasets
**/datasets/**
**/*.csv
**/*.tsv
**/*.xlsx
**/*.xls
**/*.parquet
**/*.sqlite*
**/*.db
**/*.sql
**/*.pem
**/*.key
**/*.p12
**/*.pfx